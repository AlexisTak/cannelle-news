---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import {
	blockComponents as aiBlockComponents,
	TldrBox,
} from "../../plugins/ai-editorial-assistant/src/astro";
import { blockComponents, ResearchPaperJsonLd } from "../../plugins/research-paper-embed/src/astro";
import {
	markComponents as glossaryMarkComponents,
	GlossaryJsonLd,
	GlossaryScript,
	GlossaryStyles,
} from "../../plugins/glossary-cards/src/astro";
import ArticleHeader from "../../components/ArticleHeader.astro";
import Prose from "../../components/Prose.astro";
import TagList from "../../components/TagList.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import CardGrid from "../../components/CardGrid.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getPaywallGate } from "../../utils/paywall-gate";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];

// « À lire ensuite » : les plus récents hors article courant, limité à 3.
const { entries: recent } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});
const alsoRead = recent.filter((p) => p.id !== post.id).slice(0, 3);

const customerId = Astro.cookies.get("cannelle_customer_id")?.value ?? "";
const { blocked: paywallBlocked, message: paywallMessage, checkoutUrl: paywallCheckoutUrl } =
	await getPaywallGate(Astro.url.origin, `/posts/${slug}`, customerId);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
	compactHeader
>
	<GlossaryStyles slot="head" />
	<GlossaryScript slot="head" />
	<article>
		<ArticleHeader post={post} />

		<Prose>
			<TldrBox bullets={(post.data as unknown as Record<string, unknown>).tldr} />

			{
				paywallBlocked ? (
					<div class="paywall-teaser">
						<p>{paywallMessage || "Abonnez-vous pour poursuivre votre lecture."}</p>
						{paywallCheckoutUrl && <a href={paywallCheckoutUrl}>Découvrir les offres</a>}
					</div>
				) : (
					<PortableText
						value={post.data.content}
						components={{
							types: { ...blockComponents, ...aiBlockComponents },
							marks: glossaryMarkComponents,
						}}
					/>
				)
			}
		</Prose>

		<div class="article-footer">
			<TagList tags={tags} />
		</div>

		<GlossaryJsonLd blocks={paywallBlocked ? [] : (post.data.content ?? [])} />
		<ResearchPaperJsonLd blocks={paywallBlocked ? [] : (post.data.content ?? [])} />
	</article>

	{
		alsoRead.length > 0 && (
			<section class="also-read">
				<SectionHeading label="À lire ensuite" />
				<CardGrid columns={3}>
					{alsoRead.map((p) => (
						<ArticleCard post={p} variant="standard" headingLevel={3} />
					))}
				</CardGrid>
			</section>
		)
	}

	<style>
		.article-footer,
		.also-read {
			max-width: var(--w-text);
			margin-inline: auto;
			padding-inline: var(--gutter);
		}

		.also-read {
			max-width: var(--w-page);
		}

		.paywall-teaser {
			padding: 1.5rem;
			border: 1px solid var(--border, #ddd);
			border-radius: 0.5rem;
			text-align: center;
		}
	</style>
</Base>
