---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import {
	blockComponents as aiBlockComponents,
	TldrBox,
} from "../../plugins/ai-editorial-assistant/src/astro";
import { blockComponents, ResearchPaperJsonLd } from "../../plugins/research-paper-embed/src/astro";
import {
	markComponents as glossaryMarkComponents,
	GlossaryJsonLd,
	GlossaryScript,
	GlossaryStyles,
} from "../../plugins/glossary-cards/src/astro";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<GlossaryStyles slot="head" />
	<GlossaryScript slot="head" />
	<article>
		{
			post.data.featured_image && (
				<div {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</div>
			)
		}

		<h1 {...post.edit.title}>{post.data.title}</h1>

		{
			post.data.publishedAt && (
				<time datetime={post.data.publishedAt.toISOString()}>
					{post.data.publishedAt.toLocaleDateString("en-US", {
						year: "numeric",
						month: "long",
						day: "numeric",
					})}
				</time>
			)
		}

		{
			categories.length > 0 && (
				<div>
					{categories.map((c) => (
						<a href={`/category/${c.slug}`}>{c.label}</a>
					))}
				</div>
			)
		}

		{/*
			`emdash-env.d.ts` est régénéré depuis la base au démarrage du dev
			server : `tldr` n'apparaît sur le type `Post` qu'une fois le champ
			créé (seed d'une base neuve, ou ajout via le générateur de schéma).
			L'accès est donc élargi ici pour que `astro check` passe sur une base
			antérieure au plugin ; `TldrBox` valide la valeur à l'exécution.
		*/}
		<TldrBox bullets={(post.data as unknown as Record<string, unknown>).tldr} />

		<PortableText
			value={post.data.content}
			components={{ types: { ...blockComponents, ...aiBlockComponents }, marks: glossaryMarkComponents }}
		/>

		<GlossaryJsonLd blocks={post.data.content ?? []} />
		<ResearchPaperJsonLd blocks={post.data.content ?? []} />

		{
			tags.length > 0 && (
				<div>
					{tags.map((t) => (
						<a href={`/tag/${t.slug}`}>{t.label}</a>
					))}
				</div>
			)
		}
	</article>

	<aside>
		<WidgetArea name="sidebar" />
	</aside>
</Base>
