---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Prose from "../components/Prose.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getPaywallGate } from "../utils/paywall-gate";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/${slug}`,
});

const customerId = Astro.cookies.get("cannelle_customer_id")?.value ?? "";
const { blocked: paywallBlocked, message: paywallMessage, checkoutUrl: paywallCheckoutUrl } =
	await getPaywallGate(Astro.url.origin, `/${slug}`, customerId);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
	compactHeader
>
	<article class="page">
		<header class="page__header">
			<h1 {...page.edit.title}>{page.data.title}</h1>
		</header>

		<Prose>
			{
				paywallBlocked ? (
					<div class="paywall-teaser">
						<p>{paywallMessage || "Abonnez-vous pour poursuivre votre lecture."}</p>
						{paywallCheckoutUrl && <a href={paywallCheckoutUrl}>Découvrir les offres</a>}
					</div>
				) : (
					<PortableText value={page.data.content} />
				)
			}
		</Prose>
	</article>

	<style>
		.page__header {
			max-width: var(--w-text);
			margin-inline: auto;
			padding: var(--sp-16) var(--gutter) 0;
		}

		.page__header h1 {
			font-size: var(--fs-h1);
			letter-spacing: -0.02em;
		}

		.paywall-teaser {
			padding: 1.5rem;
			border: 1px solid var(--border, #ddd);
			border-radius: 0.5rem;
			text-align: center;
		}
	</style>
</Base>
